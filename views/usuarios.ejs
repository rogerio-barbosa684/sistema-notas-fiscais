<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar Usuários - Sistema de Notas Fiscais</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .info-usuario-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 25px;
            border-radius: 10px 10px 0 0;
            margin: -25px -25px 25px -25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        
        .info-usuario-header h1 {
            margin: 0;
            font-size: 1.6em;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .perfil-atual {
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 0.8em;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .perfil-administrador { background: rgba(255, 193, 7, 0.2); color: #ffc107; border: 1px solid #ffc107; }
        
        .btn-logout {
            padding: 6px 12px;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .btn-logout:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-1px);
        }
        
        .usuarios-container {
            max-width: 1000px;
            margin: 0 auto;
            background: white;
            border-radius: 0 0 10px 10px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        
        .usuarios-header {
            padding: 25px;
            background: #f8f9fa;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        
        .usuarios-header h2 {
            margin: 0;
            color: #333;
            font-size: 1.4em;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .btn-novo-usuario {
            padding: 12px 25px;
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-novo-usuario:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
        }
        
        .usuarios-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            padding: 25px;
        }
        
        .usuario-card {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 12px;
            border-left: 4px solid #e0e0e0;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .usuario-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        }
        
        .usuario-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }
        
        .usuario-nome {
            font-size: 1.3em;
            font-weight: bold;
            color: #333;
            margin: 0;
        }
        
        .usuario-categoria {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .categoria-administrador { 
            background: #fff3cd; 
            color: #856404; 
            border: 1px solid #ffeaa7; 
        }
        
        .categoria-financeiro { 
            background: #e3f2fd; 
            color: #0d47a1; 
            border: 1px solid #bbdefb; 
        }
        
        .categoria-operacao { 
            background: #e8f5e9; 
            color: #2e7d32; 
            border: 1px solid #c8e6c9; 
        }
        
        .usuario-status {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 15px;
        }
        
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }
        
        .status-ativo { background: #4caf50; }
        .status-inativo { background: #f44336; }
        
        .usuario-email {
            color: #666;
            font-size: 0.95em;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .usuario-data {
            color: #999;
            font-size: 0.85em;
            margin-bottom: 15px;
        }
        
        .usuario-acoes {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .btn-acao {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            font-size: 0.85em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-ativar {
            background: #4caf50;
            color: white;
        }
        
        .btn-ativar:hover {
            background: #45a049;
            transform: translateY(-1px);
        }
        
        .btn-desativar {
            background: #f44336;
            color: white;
        }
        
        .btn-desativar:hover {
            background: #d32f2f;
            transform: translateY(-1px);
        }
        
        .usuarios-vazio {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        
        .usuarios-vazio div {
            font-size: 4em;
            margin-bottom: 20px;
            opacity: 0.3;
        }
        
        .estatisticas-usuarios {
            display: flex;
            justify-content: space-around;
            background: #f8f9fa;
            padding: 20px;
            border-bottom: 1px solid #e0e0e0;
            margin-bottom: 25px;
            flex-wrap: wrap;
            gap: 20px;
        }
        
        .stat-usuario {
            text-align: center;
            padding: 15px;
            background: white;
            border-radius: 10px;
            min-width: 120px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        
        .stat-usuario h4 {
            margin: 0 0 8px 0;
            color: #666;
            font-size: 0.9em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .stat-usuario .numero {
            font-size: 1.8em;
            font-weight: bold;
            color: #333;
        }
        
        @media (max-width: 768px) {
            .usuarios-grid {
                grid-template-columns: 1fr;
                gap: 15px;
                padding: 20px;
            }
            
            .usuarios-header {
                flex-direction: column;
                text-align: center;
            }
            
            .estatisticas-usuarios {
                flex-direction: column;
                align-items: center;
            }
            
            .usuario-acoes {
                justify-content: center;
            }
            
            .info-usuario-header {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="info-usuario-header">
            <h1>👥 Gerenciar Usuários</h1>
            <div style="display: flex; align-items: center; gap: 15px;">
                <span class="perfil-atual perfil-administrador">👑 Administrador</span>
                <a href="/logout" class="btn-logout" onclick="return confirm('Deseja realmente sair do sistema?')">
                    🚪 Sair
                </a>
            </div>
        </div>

        <div class="usuarios-container">
            <div class="usuarios-header">
                <h2>📋 Usuários do Sistema</h2>
                <a href="/usuarios/novo" class="btn-novo-usuario">
                    ➕ Novo Usuário
                </a>
            </div>

            <div class="estatisticas-usuarios">
                <div class="stat-usuario">
                    <h4>Total de Usuários</h4>
                    <div class="numero"><%= usuarios.length %></div>
                </div>
                <div class="stat-usuario">
                    <h4>Administradores</h4>
                    <div class="numero"><%= usuarios.filter(u => u.categoria === 'administrador').length %></div>
                </div>
                <div class="stat-usuario">
                    <h4>Financeiro</h4>
                    <div class="numero"><%= usuarios.filter(u => u.categoria === 'financeiro').length %></div>
                </div>
                <div class="stat-usuario">
                    <h4>Operação</h4>
                    <div class="numero"><%= usuarios.filter(u => u.categoria === 'operacao').length %></div>
                </div>
                <div class="stat-usuario">
                    <h4>Ativos</h4>
                    <div class="numero"><%= usuarios.filter(u => u.ativo == 1).length %></div>
                </div>
            </div>

            <% if (usuarios.length === 0) { %>
                <div class="usuarios-vazio">
                    <div>👥</div>
                    <h3>Nenhum usuário cadastrado</h3>
                    <p>Crie o primeiro usuário para começar a gerenciar o sistema.</p>
                    <a href="/usuarios/novo" class="btn-primary" style="margin-top: 15px; display: inline-block;">➕ Criar Primeiro Usuário</a>
                </div>
            <% } else { %>
                <div class="usuarios-grid">
                    <% usuarios.forEach(u => { %>
                        <div class="usuario-card">
                            <div class="usuario-header">
                                <h3 class="usuario-nome"><%= u.nome %></h3>
                                <span class="usuario-categoria categoria-<%= u.categoria %>">
                                    <%= u.categoria === 'administrador' ? '👑 Admin' : 
                                        u.categoria === 'financeiro' ? '💰 Financeiro' : '📝 Operação' %>
                                </span>
                            </div>

                            <div class="usuario-status">
                                <div class="status-indicator <%= u.ativo ? 'status-ativo' : 'status-inativo' %>"></div>
                                <span style="font-weight: 600; color: <%= u.ativo ? '#4caf50' : '#f44336' %>;">
                                    <%= u.ativo ? '✅ Ativo' : '❌ Inativo' %>
                                </span>
                            </div>

                            <div class="usuario-email">
                                📧 <strong><%= u.email %></strong>
                            </div>

                            <div class="usuario-data">
                                📅 Criado em: <%= new Date(u.created_at).toLocaleDateString('pt-BR') %>
                            </div>

                            <div class="usuario-acoes">
                                <% if (u.ativo) { %>
                                    <button onclick="desativarUsuario(<%= u.id %>)" class="btn-acao btn-desativar">
                                        ❌ Desativar
                                    </button>
                                <% } else { %>
                                    <button onclick="ativarUsuario(<%= u.id %>)" class="btn-acao btn-ativar">
                                        ✅ Ativar
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <div style="text-align: center; margin-top: 30px;">
            <a href="/" class="btn-primary">← Voltar ao Dashboard</a>
        </div>
    </div>

    <script>
        function desativarUsuario(id) {
            if (confirm('Deseja realmente desativar este usuário? Ele não poderá mais acessar o sistema.')) {
                fetch(`/api/usuarios/${id}/desativar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ Usuário desativado com sucesso!');
                        location.reload();
                    } else {
                        alert('❌ Erro: ' + (data.error || 'Erro ao desativar usuário'));
                    }
                })
                .catch(error => {
                    alert('❌ Erro de conexão.');
                    console.error(error);
                });
            }
        }

        function ativarUsuario(id) {
            if (confirm('Deseja reativar este usuário?')) {
                fetch(`/api/usuarios/${id}/ativar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ Usuário ativado com sucesso!');
                        location.reload();
                    } else {
                        alert('❌ Erro ao ativar usuário.');
                    }
                })
                .catch(error => {
                    alert('❌ Erro de conexão.');
                    console.error(error);
                });
            }
        }
    </script>
</body>
</html>
